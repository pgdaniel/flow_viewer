{
  "name": "flow_viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A Node-RED-style graph viewer/editor for flow.yml manifests from any ruby_zmq_framework-family port (Ruby, Zig, Go, Rust, Node)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/strip-dev-flow-json.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync": "node scripts/sync.mjs",
    "edit-server": "node server/flow-edit-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
